# The server reads these from its process environment. Set them in the "env"
# block of .mcp.json (or your shell). Never commit real values or secrets.

# Where the shared SQLite database lives. Default: <this folder>/data/bridge.db
# Every client that should share memory must point at the same file.
KTV_BRIDGE_DB=

# How long a claimed task stays reserved without an update_task call. Default: 600
KTV_BRIDGE_LEASE_SECONDS=600
